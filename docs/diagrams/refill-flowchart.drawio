        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;purple = a question&lt;br&gt;yellow = a person is working on it&lt;br&gt;blue = money / HR&lt;br&gt;red = refused or a person must decide&lt;br&gt;green = finished&lt;br&gt;&lt;b&gt;A / B&lt;/b&gt; circle = jump to the circle with the same letter" vertex="1">
