<mxfile host="app.diagrams.net"><diagram id="flow" name="Full flowchart"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Snack refill: every case, from &quot;empty&quot; to &quot;reimbursed&quot;" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="s1" value="1. Report" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="24" as="geometry"/></mxCell>
<mxCell id="start" value="Someone types &quot;empty&quot;&lt;br&gt;(anyone: volunteer, regular, admin)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_open" value="Is a refill already open for this office?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="210" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="d_state" value="What is it doing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="210" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_log" value="Offered: only add &quot;reported again&quot; to the history.&lt;br&gt;(one refill per office, so nobody double-buys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="130" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_nudge1" value="Committed: tell the buyer&lt;br&gt;&quot;reported empty again, still on it?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="230" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_restart" value="Escalated: people may be back.&lt;br&gt;Clear the &quot;already asked&quot; list and try again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_create" value="Create a new refill. Write &quot;X reported the box empty&quot; in its history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="d_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_open" target="d_state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="Offered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_state" target="p_log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="Committed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_state" target="p_nudge1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="Escalated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_state" target="p_restart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ja1" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="430" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e6" value="go to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_restart" target="ja1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_open" target="p_create"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p_closed" value="Office closed now? (outside 10:00-17:00 Mon-Fri, in that office&#x27;s own time)&lt;br&gt;State: &lt;b&gt;Waiting&lt;/b&gt;. Nobody is pinged. Tell the reporter &quot;someone will be asked at 10:00&quot;.&lt;br&gt;At opening, the 1-minute Tick goes on:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="350" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="ja4" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="385" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e8" value="office closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_create" target="p_closed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_closed" target="ja4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s2" value="2. Choose who buys" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="300" height="24" as="geometry"/></mxCell>
<mxCell id="d_any" value="Anyone left to ask?&lt;br&gt;volunteer, not away, in this office now (visitors count), not asked yet" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="500" width="280" height="140" as="geometry"/></mxCell>
<mxCell id="p_esc" value="State: &lt;b&gt;Escalated&lt;/b&gt;.&lt;br&gt;Tell the office contact &quot;nobody available&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="e_wait" value="Waits until someone reports &quot;empty&quot; again" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_pick" value="Pick the fairest person:&lt;br&gt;1. fewest refills in 90 days&lt;br&gt;2. longest since their last refill&lt;br&gt;3. then by id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="660" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="p_offer" value="State: &lt;b&gt;Offered&lt;/b&gt;. Ask them privately:&lt;br&gt;&quot;Can you refill? Answer within 30 min&quot; (open time only).&lt;br&gt;Thank the reporter if it is someone else." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_create" target="d_any"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ja" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ja" target="d_any"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_any" target="p_esc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_esc" target="e_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_any" target="p_pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_pick" target="p_offer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s3" value="3. Their answer" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="300" height="24" as="geometry"/></mxCell>
<mxCell id="d_ans" value="What do they answer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="900" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_no" value="&quot;no&quot;, or no answer in 30 min&lt;br&gt;(found by the 1-minute Tick).&lt;br&gt;Never ask the same person again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_valid" value="&quot;yes&quot;: still offered to them and before the deadline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1060" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_refuse" value="Refused, nothing changes:&lt;br&gt;&quot;already taken&quot; / &quot;not offered to you&quot; / &quot;offer expired&quot;.&lt;br&gt;(two &quot;yes&quot; at once: only the first wins)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="1080" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="d_budget" value="Any budget left this month?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1210" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_nobudget" value="State: &lt;b&gt;Escalated&lt;/b&gt;.&lt;br&gt;Tell the buyer &quot;don&#x27;t buy&quot;.&lt;br&gt;Tell the contact &quot;no budget left, please decide&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_commit" value="State: &lt;b&gt;Committed&lt;/b&gt;. Tell the buyer:&lt;br&gt;&quot;You can spend up to X (budget left). Above that is not paid back. 3 open hours to finish. Send the receipt.&quot;&lt;br&gt;&lt;i&gt;Less than one typical purchase left? The contact gets a &quot;budget low&quot; warning; the refill still goes ahead.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="1350" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_offer" target="d_ans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e17" value="no / silence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_ans" target="p_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ja2" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="1030" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e18" value="ask the next person" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_no" target="ja2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_ans" target="d_valid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_valid" target="p_refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_valid" target="d_budget"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e22" value="no (0 or less)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_budget" target="p_nobudget"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_budget" target="p_commit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s4" value="4. While they buy (3 open hours; the clock stops at night and weekends)" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="400" height="24" as="geometry"/></mxCell>
<mxCell id="d_next" value="What happens next?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1520" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_nudge2" value="Box reported empty again:&lt;br&gt;nudge the buyer &quot;still on it? If not, reply no&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="1596" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_late24" value="Buyer says &quot;no&quot; (can&#x27;t do it after all),&lt;br&gt;or 3 open hours pass with no &quot;done&quot; (Tick):&lt;br&gt;tell them &quot;please don&#x27;t buy&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_commit" target="d_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jb" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="1500" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="jb" target="d_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e26" value="reported again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_next" target="p_nudge2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ja3" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="1636" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e27" value="next person" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_late24" target="ja3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e28" value="&quot;no&quot; or time up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_next" target="p_late24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s5" value="5. &quot;done &lt;amount&gt; &lt;snacks&gt;&quot; + receipt" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="400" height="24" as="geometry"/></mxCell>
<mxCell id="d_mine" value="Is this their own open refill (Committed to them)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1710" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="d_other" value="Has someone else taken it over, and were they asked before?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="1710" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="p_lateclaim" value="Late receipt: &lt;b&gt;not claimed&lt;/b&gt;.&lt;br&gt;Tell the contact &quot;X paid after it was handed on, please check&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1240" y="1650" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_dup" value="Ignored, no alarm&lt;br&gt;(e.g. &quot;done&quot; sent twice)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="1790" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_amount" value="Amount above 0 and in this office&#x27;s currency?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1870" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_badamt" value="Refused: &quot;invalid amount&quot; / &quot;wrong currency&quot;.&lt;br&gt;Still Committed, they can send again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="1890" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_limit" value="Receipt above the spending limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="2030" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_cap" value="Claim only the limit.&lt;br&gt;Tell the buyer &quot;the rest is not paid back&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="2050" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="e29" value="&quot;done&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_next" target="d_mine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e30" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_mine" target="d_other"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e31" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_other" target="p_lateclaim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_other" target="p_dup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_mine" target="d_amount"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e34" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_amount" target="p_badamt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="jb2" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="1908" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="e35" value="send again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_badamt" target="jb2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e36" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_amount" target="d_limit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_limit" target="p_cap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="s6" value="6. Spending and the HR claim" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2170" width="400" height="24" as="geometry"/></mxCell>
<mxCell id="p_filled" value="State: &lt;b&gt;Filled&lt;/b&gt;. Count the spend in the budget NOW (not at HR approval). Count one refill for fairness.&lt;br&gt;&lt;i&gt;Budget below 0 (only if an admin lowered it)? Tell the contact &quot;over budget&quot;.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="2190" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="p_send" value="Send the claim to HR: who, amount, snacks, receipt, key = refill id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="2330" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_hrup" value="Did HR answer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="2440" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="p_retry" value="Stay &lt;b&gt;Filled&lt;/b&gt;. The 1-minute Tick tries again with the SAME key, so HR never makes two claims." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="860" y="2460" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="p_claimed" value="State: &lt;b&gt;Claimed&lt;/b&gt;. Tell the buyer &quot;claim C-n sent, 1-10 days&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="2600" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="d_hr" value="HR decision (webhook / daily check)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="2710" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="e_ok" value="&lt;b&gt;Reimbursed&lt;/b&gt;&lt;br&gt;Thank the buyer. Done." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="2730" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="e_rej" value="&lt;b&gt;ClaimRejected&lt;/b&gt;&lt;br&gt;Give the money back to the budget. Tell the buyer and the contact; people sort it out." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2720" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="e38" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_limit" target="p_filled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e39" value="claim the limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_cap" target="p_filled"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="2223"/></Array></mxGeometry></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_filled" target="p_send"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_send" target="d_hrup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e42" value="no (HR down)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_hrup" target="p_retry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e43" value="next minute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_retry" target="p_send"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="2368"/></Array></mxGeometry></mxCell>
<mxCell id="e44" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_hrup" target="p_claimed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_claimed" target="d_hr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e46" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_hr" target="e_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e47" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_hr" target="e_rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="side" value="&lt;b&gt;Any time (outside the flow)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin&lt;/b&gt; (Lars / Deepa) types &quot;set budget oslo 7000 300 1200&quot; or &quot;set timer accept 45&quot;: checked, applies at once. Anyone else is refused.&lt;br&gt;&lt;br&gt;&lt;b&gt;&quot;away 3&quot;&lt;/b&gt;: that person is skipped for 3 days.&lt;br&gt;&lt;br&gt;&lt;b&gt;Report&lt;/b&gt;: per office in its own currency, one combined total, snacks counted, every purchase listed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Visitors&lt;/b&gt;: asked in the office they are visiting, spending counts there.&lt;br&gt;&lt;br&gt;&lt;b&gt;Office hours&lt;/b&gt;: if an office closes while someone is being asked, the refill goes to &lt;b&gt;Waiting&lt;/b&gt; and carries on at 10:00." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="2030" width="300" height="350" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;purple = a question&lt;br&gt;yellow = a person is working on it&lt;br&gt;blue = money / HR&lt;br&gt;red = refused or a person must decide&lt;br&gt;green = finished&lt;br&gt;&lt;b&gt;A / B&lt;/b&gt; circle = jump to the circle with the same letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;align=left;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="2440" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
